{
  "exe": "<XM_ROOT>\\xestrata\\build\\mixed\\strata.exe",
  "args": [
    "--pack",
    "<path to the Strata pack folder>",
    "--native",
    "<model>-00001-of-0000N.gguf",
    "--ple-gguf",
    "<model>-00001-of-0000N.gguf",
    "--expert-profile",
    "<XM_ROOT>\\xestrata\\data\\expert-profile.bin",
    "--expert-cache",
    "auto",
    "--prefill",
    "4096",
    "--max-context",
    "131072",
    "--kv",
    "k8v4",
    "--mmap-experts",
    "--resident-budget-gib",
    "2",
    "--pool-workers",
    "6",
    "--layer-split",
    "<K: first layer of the second GPU>",
    "--split-device",
    "1",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--mtp",
    "<path to the MTP files>",
    "--vram-reserve-mib",
    "1800"
  ],
  "cwd": "<XM_ROOT>\\xestrata\\build\\mixed",
  "tokenizer": "<pack folder>\\tokenizer",
  "model_name": "my-model-mixed",
  "log": "<XM_ROOT>\\logs\\engine.log",
  "lib_dirs": [
    "<XM_ROOT>\\xestrata\\build\\mixed",
    "<XM_ROOT>\\xestrata\\build\\mixed\\bin",
    "<XM_ROOT>\\intel-llvm\\install\\bin",
    "<ROCm short path>\\bin"
  ],
  "port": 8097,
  "env": {
    "ONEAPI_DEVICE_SELECTOR": "hip:0;cuda:0",
    "STRATA_RESIDENT_PIN": "0",
    "ROCM_PATH": "<ROCm short path>",
    "CUDA_PATH": "<CUDA short path>",
    "STRATA_VERIFY_ASYNC_LAUNCH": "0"
  },
  "reasoning_effort": "low"
}
